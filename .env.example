# Vexo Garage — production backend env template
# Copy to .env / apps/web/.env.local — never commit secrets.

# Supabase - Primary DB - Prisma 14-table national schema
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.vdtyzqzdakfckpcjxxpi.supabase.co:5432/postgres
# VPS note: if db.*.supabase.co:5432 is IPv6-only / unreachable, use pooler:
# DATABASE_URL=postgresql://postgres.vdtyzqzdakfckpcjxxpi:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

